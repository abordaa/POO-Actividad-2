if __name__ == "__main__":
    # Creación de los objetos
    p1 = Persona("Pedro", "Pérez", "1053121010", 1998, "Colombia", 'M')
    p2 = Persona("Luis", "León", "1053223344", 2001, "Panama", 'M')

    # Llamado al método imprimir
    p1.imprimir()
    p2.imprimir()
